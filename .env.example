# ========================================================
# NEXUS AI — ROOT ENVIRONMENT VARIABLES SPECIFICATION
# ========================================================

# --------------------------------------------------------
# FRONTEND (apps/frontend/.env.local)
# --------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=http://localhost:5000

# --------------------------------------------------------
# BACKEND (apps/backend/.env)
# --------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nexus_ai?retryWrites=true&w=majority
JWT_ACCESS_SECRET=nexus_super_secret_jwt_access_token_key_change_in_production_32chars
JWT_REFRESH_SECRET=nexus_super_secret_jwt_refresh_token_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:3000
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Providers (Provider-agnostic adapter)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
DEFAULT_AI_PROVIDER=groq

# Integrations
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
VERCEL_CLIENT_ID=your_vercel_client_id
VERCEL_CLIENT_SECRET=your_vercel_client_secret
HEROKU_CLIENT_ID=your_heroku_client_id
HEROKU_CLIENT_SECRET=your_heroku_client_secret

# --------------------------------------------------------
# NEXUS VPS AGENT (apps/vps-agent/.env)
# --------------------------------------------------------
NEXUS_BACKEND_URL=http://localhost:5000
NEXUS_AGENT_TOKEN=nexus_agent_token_generated_by_backend
NEXUS_SERVER_ID=server_mongo_object_id
NEXUS_METRICS_INTERVAL=3000
